{
  "name": "@heysutton/lib-frontend",
  "version": "1.0.0",
  "description": "Digit custom app host bridge, API hooks, and AppErrorAlert. DigitThemeProvider is a temporary re-export; theme and UI source of truth is @heysutton/ui from digit-web (not published from this repo).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digit-Technologies/digit-apps-starter.git",
    "directory": "packages/lib-frontend"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@heysutton/lib-common": "1.0.0",
    "inter-ui": "4.1.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/material": "^9",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^7.0.2"
  }
}
